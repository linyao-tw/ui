{
	"name": "@lyds/ui",
	"version": "0.0.0",
	"description": "LYDS retro-industrial React component design system",
	"keywords": [
		"react",
		"components",
		"design-system",
		"base-ui",
		"accessibility"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/linyao-tw/ui.git",
		"directory": "packages/ui"
	},
	"license": "Apache-2.0",
	"sideEffects": [
		"**/*.css"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "vite build",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@internationalized/date": "^3.12.3",
		"react-aria-components": "^1.20.0"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.6",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.1",
		"axe-core": "^4.13.0",
		"jsdom": "^26.1.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"vite": "^8.2.2",
		"vite-plugin-dts": "^5.0.3",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"react": "^18.3.0 || ^19.0.0",
		"react-dom": "^18.3.0 || ^19.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
