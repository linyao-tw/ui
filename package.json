{
	"name": "linyao-design-system",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm build:package && pnpm --filter @lyds/storybook build",
		"build:package": "pnpm --filter @linyao.tw/ui build",
		"build:storybook": "pnpm build:package && pnpm --filter @lyds/storybook build",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "pnpm build:package && eslint . --max-warnings 0 && pnpm lint:css",
		"lint:css": "node scripts/check-css.mjs",
		"pack:check": "node scripts/verify-package.mjs",
		"prepare": "sh -c 'if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git config core.hooksPath .githooks; fi'",
		"storybook": "pnpm build:package && pnpm --filter @lyds/storybook storybook",
		"test": "pnpm test:unit && pnpm test:storybook",
		"test:release": "node --test scripts/release/*.test.mjs",
		"test:storybook": "pnpm --filter @lyds/storybook test",
		"test:unit": "pnpm --filter @linyao.tw/ui test",
		"test:watch": "pnpm --filter @linyao.tw/ui test:watch",
		"typecheck": "pnpm build:package && pnpm -r --if-present typecheck"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@eslint/js": "^9.39.5",
		"@types/node": "^24.10.0",
		"eslint": "^9.39.5",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^16.5.0",
		"prettier": "^3.9.6",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-packagejson": "^3.0.2",
		"publint": "^0.3.24",
		"semver": "^7.8.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0"
	},
	"packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
	"engines": {
		"node": ">=22.13.0"
	}
}
